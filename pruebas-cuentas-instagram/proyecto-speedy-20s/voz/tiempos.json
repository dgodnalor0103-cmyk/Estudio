  "frases": [
    {
      "n": 1,
      "texto": "Cuando tu dedo toca el celular, no estás presionando ningún botón.",
      "clave": "botón",
      "inicio": 0,
      "fin": 4.4
    },
    {
      "n": 2,
      "texto": "Tu piel roba una pequeña carga eléctrica del cristal para marcar el punto exacto.",
      "clave": "eléctrica",
      "inicio": 4.44,
      "fin": 9.52
    },
    {
      "n": 3,
      "texto": "Además, tres capas invisibles agrandan en secreto la siguiente letra de tu teclado.",
      "clave": "secreto",
      "inicio": 9.6,
      "fin": 14.8
    },
    {
      "n": 4,
      "texto": "Por eso aciertas cada palabra aunque escribas corriendo y sin mirar la pantalla.",
      "clave": "pantalla",
      "inicio": 15.04,
      "fin": 19.76
    }
  ],
