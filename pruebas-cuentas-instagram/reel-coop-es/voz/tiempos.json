  "frases": [
    {
      "n": 1,
      "texto": "Claude ahora convierte tus juegos de un jugador en cooperativo.",
      "clave": "cooperativo",
      "inicio": 0,
      "fin": 3.52
    },
    {
      "n": 2,
      "texto": "Es un repositorio gratis que tu agente lee para buscar cualquier mod.",
      "clave": "gratis",
      "inicio": 3.92,
      "fin": 7.68
    },
    {
      "n": 3,
      "texto": "Repara uno abandonado o lo crea desde cero, como Zelda y Deus-Ex.",
      "clave": "cero",
      "inicio": 8.08,
      "fin": 12.08
    },
    {
      "n": 4,
      "texto": "Tu amigo solo entra por Steam, sin abrir puertos ni compartir IP.",
      "clave": "Steam",
      "inicio": 12.48,
      "fin": 16.08
    },
    {
      "n": 5,
      "texto": "Sumó mil trescientas estrellas; comenta COOP y te envío todos los enlaces.",
      "clave": "COOP",
      "inicio": 16.48,
      "fin": 21.28
    }
  ],
