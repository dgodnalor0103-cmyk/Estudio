{
  "firma": "170031b6abba",
  "duracion": 69.6,
  "frases": [
    {
      "n": 1,
      "texto": "¿Notaste que al apagar el WiFi en la barra rápida de tu celular el botón blanco no lo apaga?",
      "clave": "apaga",
      "inicio": 0,
      "fin": 5.24
    },
    {
      "n": 2,
      "texto": "Porque esta noche, apenas apagues la luz de tu cuarto, va a seguir buscando redes solo.",
      "clave": "noche",
      "inicio": 5.52,
      "fin": 10.36
    },
    {
      "n": 3,
      "texto": "Apple confirma que ese botón blanco solo te desconecta del router, pero deja tu antena encendida.",
      "clave": "antena",
      "inicio": 10.64,
      "fin": 16.08
    },
    {
      "n": 4,
      "texto": "Lo hace para que AirDrop, tu reloj y la ubicación sigan funcionando todo el tiempo.",
      "clave": "reloj",
      "inicio": 16.32,
      "fin": 21.48
    },
    {
      "n": 5,
      "texto": "Peor aún: en tu iPhone, a las cinco de la mañana se reconecta solo mientras duermes.",
      "clave": "cinco",
      "inicio": 21.76,
      "fin": 26.84
    },
    {
      "n": 6,
      "texto": "Y en Android pasa igual: aunque lo apagues, Ubicación sigue escaneando las redes de tus vecinos.",
      "clave": "vecinos",
      "inicio": 27.04,
      "fin": 32.32
    },
    {
      "n": 7,
      "texto": "Es como cerrar con llave tu puerta principal, pero dejar todas las ventanas abiertas de noche.",
      "clave": "ventanas",
      "inicio": 32.72,
      "fin": 37.44
    },
    {
      "n": 8,
      "texto": "Al salir a la calle, ese rastreo gasta tu batería y registra por qué tiendas pasaste.",
      "clave": "batería",
      "inicio": 37.92,
      "fin": 42.96
    },
    {
      "n": 9,
      "texto": "Para apagarlo de raíz de verdad, entra directo a Ajustes y desactiva WiFi hasta verlo tachado.",
      "clave": "Ajustes",
      "inicio": 43.2,
      "fin": 49
    },
    {
      "n": 10,
      "texto": "Y en teléfonos Android, apaga también la búsqueda oculta de WiFi dentro de Ubicación.",
      "clave": "Ubicación",
      "inicio": 49.2,
      "fin": 53.84
    },
    {
      "n": 11,
      "texto": "Recuerda que si solo tocas arriba, a mitad de la noche tu antena vuelve a despertar.",
      "clave": "despertar",
      "inicio": 54.32,
      "fin": 59.08
    },
    {
      "n": 12,
      "texto": "Envíaselo ahora a ese amigo que lo apaga desde arriba creyendo ahorrar batería.",
      "clave": "amigo",
      "inicio": 59.36,
      "fin": 63.48
    },
    {
      "n": 13,
      "texto": "Y no te pierdas mañana la parte dos: cómo un cable barato quema tu celular por dentro.",
      "clave": "cable",
      "inicio": 63.68,
      "fin": 68.8
    }
  ],
