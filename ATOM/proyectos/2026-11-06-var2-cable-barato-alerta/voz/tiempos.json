{
  "firma": "546d92477126",
  "duracion": 61.36,
  "frases": [
    {
      "n": 1,
      "texto": "Tu cargador rápido original no daña tu celular, pero un cable barato sí puede quemarlo por dentro.",
      "clave": "cable",
      "inicio": 0,
      "fin": 6.08
    },
    {
      "n": 2,
      "texto": "Por fuera los dos conectores se ven iguales, pero por dentro uno viene completamente vacío.",
      "clave": "vacío",
      "inicio": 6.32,
      "fin": 11.68
    },
    {
      "n": 3,
      "texto": "El cable original esconde un microchip inteligente que negocia el voltaje exacto con tu celular.",
      "clave": "microchip",
      "inicio": 12.08,
      "fin": 17.48
    },
    {
      "n": 4,
      "texto": "Carga rápido hasta el 80 % y luego frena solo para no calentar tu batería.",
      "clave": "frena",
      "inicio": 17.68,
      "fin": 22.56
    },
    {
      "n": 5,
      "texto": "En cambio, ese cable barato no trae chip y lleva hilos de cobre finísimos.",
      "clave": "cobre",
      "inicio": 22.96,
      "fin": 27.68
    },
    {
      "n": 6,
      "texto": "Es igual a meter toda el agua de tu casa por un tubo finito sin válvula: la unión revienta.",
      "clave": "válvula",
      "inicio": 27.84,
      "fin": 33.36
    },
    {
      "n": 7,
      "texto": "Sin ese control, la corriente calienta los pines del puerto y quema el chip de carga interior.",
      "clave": "quema",
      "inicio": 33.76,
      "fin": 38.8
    },
    {
      "n": 8,
      "texto": "Por eso la punta metálica quema al tocarla y tu teléfono solo carga cuando doblas el cable.",
      "clave": "doblas",
      "inicio": 38.96,
      "fin": 44.4
    },
    {
      "n": 9,
      "texto": "Para evitarlo hoy, usa cables certificados y desconéctalo de inmediato si la punta se calienta.",
      "clave": "certificados",
      "inicio": 44.48,
      "fin": 50
    },
    {
      "n": 10,
      "texto": "Envíaselo ahora a ese amigo que siempre compra el cable más barato de la esquina.",
      "clave": "amigo",
      "inicio": 50.12,
      "fin": 54.48
    },
    {
      "n": 11,
      "texto": "Y guarda este video para mañana, parte tres: dónde quedan de verdad las fotos que borras de tu celular.",
      "clave": "fotos",
      "inicio": 54.52,
      "fin": 60.56
    }
  ],
